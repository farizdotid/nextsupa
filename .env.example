# Supabase project URL (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key — safe for browser, protected by RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Base URL of this site (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: log in with dummy data, no Supabase needed (dev only).
# Set to false once you add real Supabase keys.
NEXT_PUBLIC_DEMO_MODE=true
